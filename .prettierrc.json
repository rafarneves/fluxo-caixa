{
    "useTabs": false,
    "tabWidth": 4,
    "trailingComma": "es5",
    "semi": true,
    "singleQuote": true,
    "printWidth": 120,
    "bracketSameLine": false,
    "bracketSpacing": true,
    "overrides": [
        {
            "files": ["*.ts", "*.mts", "*.d.ts"],
            "options": {
                "parser": "typescript",
                "plugins": ["prettier-plugin-multiline-arrays", "prettier-plugin-tailwindcss"]
            }
        },
        {
            "files": ["*.tsx", "*.mtsx"],
            "options": {
                "parser": "typescript",
                "plugins": ["prettier-plugin-multiline-arrays", "prettier-plugin-tailwindcss"]
            }
        }
    ]
}
